{
  "manifest_version": 3,
  "name": "豆包图片粘贴助手",
  "version": "1.0.0",
  "description": "在豆包网页版支持 Ctrl+V 粘贴图片上传",
  "permissions": [
    "activeTab"
  ],
  "host_permissions": [
    "https://*.doubao.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://*.doubao.com/*"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ]
}
